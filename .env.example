# Ark-push environment
HTTP_PORT=7701
STATE_DIR=/state
STRM_ROOT=/src
UI_DIR=/app/ui
TZ=Asia/Shanghai
LOG_LEVEL=info

# LitePan backend (can also be saved from the Settings page)
# Container reaches the backend over the network - use an address reachable from inside the container
LITEPAN_URL=https://<你的LitePan域名>:<端口>
LITEPAN_USERNAME=admin
LITEPAN_PASSWORD=
LITEPAN_INSECURE=on   # set to on for self-signed HTTPS certificates

# 115 push gate
LINK_115=off
LINK_ENABLED=on
PUSH_ALLOW_ANON=off

# scheduler
SYNC_INTERVAL_MIN=10
LINK_INTERVAL_MIN=60
OFFLINE_TIMEOUT_MIN=120

# cache
CACHE_DIR=
ACTOR_AVATAR_DIR=
PLOT_MAX_CHARS=600
NETDISK_MAX_DIRS=20000

# plugin system is not enabled in this Rust build
PLUGINS_ENABLED=off
